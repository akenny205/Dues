# Copy this file to .env.local (dev) and fill in the values from whichever
# Supabase project you're targeting. .env.local is gitignored — never commit
# real values. For a production deploy, set these same three names in your
# host's dashboard (see NETLIFY_DEPLOY.md) pointed at your PRODUCTION
# Supabase project instead — .env.local only affects `npm run dev` locally.

# Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings > API > Project API keys > service_role — SECRET, server-side only
# (used by src/app/api/delete-auth-user). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: run the app against in-memory demo data instead of Supabase at
# all — no project needed. Usually set inline via `npm run dev:demo` instead
# of here; see README-DEMO.md.
# NEXT_PUBLIC_DEMO_MODE=true
